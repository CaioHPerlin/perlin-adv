meta {
  name: 03 - Login
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/auth/sign-in/email
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("sessionToken", res.body.token);
  }
}
