meta {
  name: 07 - List Publications
  type: http
  seq: 7
}

get {
  url: {{base_url}}/publications
}

headers {
  Cookie: {{sessionToken}}
}

params:query {
  page: 1
  limit: 5
}

script:post-response {
  if (res.status === 200 && res.body.publications.length > 0) {
    bru.setVar("pubId", res.body.publications[0].id);
  }
}
