meta {
  name: 02 - Register
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/auth/sign-up/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{name}}",
    "email": "{{email}}",
    "password": "{{password}}",
    "oabNumber": "{{oab_number}}",
    "oabUf": "{{oab_uf}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("userId", res.body.user.id);
    bru.setVar("userToken", res.body.token);
  }
}
